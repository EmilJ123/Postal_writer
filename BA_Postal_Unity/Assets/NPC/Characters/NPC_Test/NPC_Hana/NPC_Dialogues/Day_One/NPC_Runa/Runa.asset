  m_Name: Runa
  m_EditorClassIdentifier: Assembly-CSharp::S_NPCDialogue
  npcName: Runa
  npcPortrait: {fileID: 0}
  dialogueLines:
  - text: You're the new writer. thought you'd be taller.
    autoProgress: 1
    endDialogue: 0
  - text: I'm joking. Mostly.
    autoProgress: 1
    endDialogue: 0
  - text: "I\u2019m Runa. Keeper of the chapel. Caretaker of the sick. Occasional snow-shoveler. "
    autoProgress: 1
    endDialogue: 0
  - text: 'And apparently one of Mr. Bell''s newest customers. '
    autoProgress: 1
    endDialogue: 0
  - text: 'I need something written '
    autoProgress: 1
    endDialogue: 0
  - text: 'Unfortunately. It''s for someone in town. '
    autoProgress: 1
    endDialogue: 0
  - text: "...\n "
    autoProgress: 1
    endDialogue: 1
  - text: 'The address is enough? Yes. Good. '
    autoProgress: 1
    endDialogue: 1
  - text: "\u2026Someone who doesn't need the entire town knowing her business. "
    autoProgress: 1
    endDialogue: 1
  autoProgressDelay: 2
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
  choices:
  - dialogueIndex: 6
    choices:
    - Ask who the letter is for.
    - Gesture gently toward the blank address line.
    nextDialogueIndices: 0700000008000000i
