  m_Script: {fileID: 11500000, guid: 0370f504232484e80819c75b7f1b711f, type: 3}
  m_Name: Runa_day1
  m_EditorClassIdentifier: Assembly-CSharp::S_NPCDialogue
  npcName: Runa
  npcPortrait: {fileID: 0}
  dialogueLines:
  - text: You're the new writer. Thought you'd be taller.
    autoProgress: 0
    endDialogue: 0
  - text: I'm joking. Mostly.
    autoProgress: 0
    endDialogue: 0
  - text: I'm Runa. Keeper of the chapel. Caretaker of the sick. Occasional snow-shoveler.
    autoProgress: 0
    endDialogue: 0
  - text: And apparently one of MR.Bell's newest costumers.
    autoProgress: 0
    endDialogue: 0
  - text: I need something written...
    autoProgress: 0
    endDialogue: 0
  - text: Unfortunately...
    autoProgress: 0
    endDialogue: 0
  - text: It's for someone in town.
    autoProgress: 0
    endDialogue: 0
  - text: ...
    autoProgress: 0
    endDialogue: 0
  - text: "\u2026Someone who doesn't need the entire town knowing her business."
    autoProgress: 0
    endDialogue: 1
  - text: The address is enough? Yes. Good.
    autoProgress: 0
    endDialogue: 1
  - text: To my friend, i hope the night finds you well. I have some extra medicine from the chapel. The bitter kind. I thought you might appreciate having it before the roads become worse. please remember to stay indoors whne the snow gets heavy. The path near the old bridge has become treacherous again, and I would rather not have to come looking for you in the blizzard. And eat something. I know you said you were fine, but you always say that. You cannot live on tea nad stubborness alone, no matter how determined you are to prove otherwise. I will be at the chapel tomorrow evening. If you happen to be passing by, you may stop in. You don't have to stay long. You don't even have to talk, if you don't want to. I only thought it might be nice to seee you. The medicine is in the little brown bottle. Not the green one. The green one is for coughs, and I don't want you taking the wrong thing because you refused to ask. Please be careful on the road. -R
    autoProgress: 0
    endDialogue: 1
  - text: 
    autoProgress: 0
    endDialogue: 0
  autoProgressDelay: 2
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
  choices:
  - dialogueIndex: 7
    choices:
    - Ask who the letter is for.
    - Gesture gently towards the bland address line.
    nextDialogueIndices: 0800000009000000i
    givesQuest: 0101y
