  dialogueLines:
  - text: 'You''re the writer. '
    autoProgress: 0
    endDialogue: 0
  - text: 'Mr.Bell told me. He tells everyone everything. '
    autoProgress: 0
    endDialogue: 0
  - text: 'Tell, me. Does Runa still pretend she doesn''t know how to write? '
    autoProgress: 0
    endDialogue: 0
  - text: 'Just because she hates admitting when something matters to her. '
    autoProgress: 0
    endDialogue: 0
  - text: I suppose that's one of the things i've always liked about her.
    autoProgress: 0
    endDialogue: 0
  - text: Don't look so pleased. You're not te first one to notice.
    autoProgress: 0
    endDialogue: 0
  - text: Actually....
    autoProgress: 0
    endDialogue: 0
  - text: 'Could you write something for me? '
    autoProgress: 0
    endDialogue: 0
  - text: That's all.
    autoProgress: 0
    endDialogue: 0
  - text: 'you have a good way of making people sound braver than they feel. '
    autoProgress: 0
    endDialogue: 0
  - text: '... '
    autoProgress: 0
    endDialogue: 0
  - text: 'No, no Don''t be modest. it''s unbecoming. '
    autoProgress: 0
    endDialogue: 1
